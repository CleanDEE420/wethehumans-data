{"cards":[{"title":"TOO SOON? TOO LATE.","sub":"'Not yet' forever turns into 'never'.","img":"https://raw.githubusercontent.com/CleanDEE420/wethehumans-data/main/quotes/b2-01-too-soon-too-late.jpg","batch":2,"id":"b2-01-too-soon-too-late"},{"title":"GOOD DAYS ONLY? NOTHING GETS DONE.","sub":"Show up on the bad ones too.","img":"https://raw.githubusercontent.com/CleanDEE420/wethehumans-data/main/quotes/b2-02-show-up-anyway.jpg","batch":2,"id":"b2-02-show-up-anyway"},{"title":"BRAVER THAN YOU BELIEVE, STRONGER THAN YOU THINK.","sub":"There's more in you than you know.","img":"https://raw.githubusercontent.com/CleanDEE420/wethehumans-data/main/quotes/b2-03-braver-stronger.jpg","batch":2,"id":"b2-03-braver-stronger"},{"title":"EVERYBODY GROWS AT DIFFERENT RATES.","sub":"Your pace is still progress.","img":"https://raw.githubusercontent.com/CleanDEE420/wethehumans-data/main/quotes/b2-04-different-rates.jpg","batch":2,"id":"b2-04-different-rates"},{"title":"SAME 24 HOURS. LIVE THEM.","sub":"Nobody gets extra. Spend yours well.","img":"https://raw.githubusercontent.com/CleanDEE420/wethehumans-data/main/quotes/b2-05-same-hours.jpg","batch":2,"id":"b2-05-same-hours"},{"title":"IMPORTANT TO YOU? FIND A WAY.","sub":"If not, you'll find an excuse.","img":"https://raw.githubusercontent.com/CleanDEE420/wethehumans-data/main/quotes/b2-06-find-a-way.jpg","batch":2,"id":"b2-06-find-a-way"},{"title":"STRENGTH COMES FROM OVERCOMING IT.","sub":"Especially what you thought you couldn't.","img":"https://raw.githubusercontent.com/CleanDEE420/wethehumans-data/main/quotes/b2-07-strength-overcoming.jpg","batch":2,"id":"b2-07-strength-overcoming"},{"title":"WANT SOMETHING? GO GET IT.","sub":"Learn how to chew.","img":"https://raw.githubusercontent.com/CleanDEE420/wethehumans-data/main/quotes/b1-01-go-get-it.jpg","batch":1,"id":"b1-01-go-get-it"},{"title":"100% HUMAN / 0% ROBOT","sub":"All heart. No autopilot.","img":"https://raw.githubusercontent.com/CleanDEE420/wethehumans-data/main/quotes/b1-02-100-human.jpg","batch":1,"id":"b1-02-100-human"},{"title":"IT'S ONLY METAL.","sub":"If it's metal, it's fixable.","img":"https://raw.githubusercontent.com/CleanDEE420/wethehumans-data/main/quotes/b1-03-only-metal.jpg","batch":1,"id":"b1-03-only-metal"},{"title":"DO ONLY GOOD EVERYDAY.","sub":"That's the rule. Every day.","img":"https://raw.githubusercontent.com/CleanDEE420/wethehumans-data/main/quotes/b1-04-do-only-good.jpg","batch":1,"id":"b1-04-do-only-good"},{"title":"STAY AWESOME, HUMANS!","sub":"Pass it on.","img":"https://raw.githubusercontent.com/CleanDEE420/wethehumans-data/main/quotes/b1-05-stay-awesome.jpg","batch":1,"id":"b1-05-stay-awesome"},{"title":"TIRED BUT STILL HERE.","sub":"Still here beats never showed up.","img":"https://raw.githubusercontent.com/CleanDEE420/wethehumans-data/main/quotes/b1-06-tired-still-here.jpg","batch":1,"id":"b1-06-tired-still-here"},{"title":"POWERED BY SPITE & SNACKS","sub":"Breakfast of champions.","img":"https://raw.githubusercontent.com/CleanDEE420/wethehumans-data/main/quotes/b1-07-spite-snacks.jpg","batch":1,"id":"b1-07-spite-snacks"}]}